---
permalink: /index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="pt-MZ">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Casas de Apostas Moçambique 2026: Comparação | MocaPlay</title>
  <meta name="description" content="Compare as melhores casas de apostas em Moçambique licenciadas pela IGJ: Placard, Olabet, 888bets, Betway e Elephant Bet. Depósitos desde 1 MT e bónus.">
  <link rel="canonical" href="{{ site.dominio }}/">

  <!-- Open Graph / Redes Sociais -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Casas de Apostas Moçambique 2026: Comparação | MocaPlay">
  <meta property="og:description" content="Ranking independente das casas de apostas licenciadas em Moçambique. Compare depósitos mínimos de 1 MT via M-Pesa, e-Mola, M-Kesh e regras reais de bónus.">
  <meta property="og:url" content="{{ site.dominio }}/">
  <meta property="og:site_name" content="{{ site.nome }}">
  <meta property="og:locale" content="pt_MZ">
  <meta property="og:image" content="{{ site.dominio }}{{ site.capa_padrao }}">

  <!-- Favicon Oficial -->
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48">
  <link rel="icon" type="image/png" href="/favicon-32x32.png?v=2" sizes="32x32">
  <link rel="icon" type="image/png" href="/android-chrome-192x192.png?v=2" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="stylesheet" href="/style.css">

  <!-- Dados Estruturados JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.dominio }}/#organization",
        "name": "{{ site.nome }}",
        "url": "{{ site.dominio }}/",
        "logo": "{{ site.dominio }}{{ site.logo_header }}",
        "description": "Portal independente de comparação e análise de casas de apostas desportivas licenciadas em Moçambique."
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.dominio }}/#website",
        "url": "{{ site.dominio }}/",
        "name": "MocaPlay Moçambique",
        "inLanguage": "pt-MZ",
        "publisher": { "@id": "{{ site.dominio }}/#organization" }
      }
    ]
  }
  </script>
</head>
<body>

  <!-- 1. TOPBAR -->
  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-left">
        <span class="live-dot" aria-hidden="true"></span>
        <span id="current-date">Qua, 25 Nov 2026</span>
        <span class="topbar-trending">
          <strong>Em Destaque:</strong> {{ site.topbar_destaque }}
        </span>
      </div>
      <div class="topbar-right">
        <span class="badge-18">+18</span>
        <span>Jogue com moderação</span>
      </div>
    </div>
  </div>

  <!-- 2. HEADER BRANCO ESTILO USA TODAY -->
  <header class="site-header">
    <div class="container header-grid">
      <a href="/" class="brand-logo" aria-label="{{ site.nome }} - Página Inicial">
        <img src="{{ site.logo_header }}" alt="{{ site.nome }}" class="brand-logo-full" width="180" height="44">
      </a>

      <div class="header-banner">
        <div class="header-banner-text">
          <strong>Destaque do Mês:</strong> Placard.co.mz com depósitos desde 1 MT (M-Pesa/e-Mola/M-Kesh) e Boost 1000%.
        </div>
        <a href="{{ site.cta_header_url }}" target="_blank" rel="sponsored nofollow noopener" class="btn btn-cta btn-sm">
          Visitar Placard &rarr;
        </a>
      </div>
    </div>
  </header>

  <!-- 3. MENU DE NAVEGAÇÃO -->
  <nav class="navbar" aria-label="Navegação Principal">
    <div class="container navbar-inner">
      <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="nav-links">
        &#9776; Menu
      </button>

      <ul class="nav-links" id="nav-links">
        <li><a href="/" class="active">Início</a></li>
        <li><a href="/melhores-casas-de-apostas-mocambique">Melhores Casas</a></li>
        <li><a href="/codigos-promocionais-e-bonus">Bónus &amp; Códigos</a></li>
        <li><a href="/pagamentos/m-pesa">M-Pesa &amp; Pagamentos</a></li>
        <li><a href="/apps-de-apostas-mocambique">Apps Mobile</a></li>
        <li><a href="/guias/como-apostar-iniciantes">Guias</a></li>
        <li><a href="/apostas-futebol/">Futebol &amp; Moçambola</a></li>
      </ul>

      <a href="{{ site.cta_header_url }}" target="_blank" rel="sponsored nofollow noopener" class="nav-cta-btn">
        &#9654; {{ site.cta_header_texto }}
      </a>
    </div>
  </nav>

  <!-- 4. FAIXA DE DESTAQUES RÁPIDOS COM MINIATURAS (ESTILO USA TODAY) -->
  <div class="quick-strip">
    <div class="container quick-strip-grid">
      <a href="/pagamentos/m-pesa" class="quick-strip-card">
        <img src="{{ site.capa_padrao }}" alt="Depósitos M-Pesa" class="quick-strip-thumb" width="68" height="52">
        <div class="quick-strip-meta">
          <strong>Depósitos desde 1 MT via M-Pesa e e-Mola</strong>
          <span>Pagamentos Móveis MZ</span>
        </div>
      </a>
      <a href="/guias/aviator-e-jogos-crash" class="quick-strip-card">
        <img src="{{ site.capa_padrao }}" alt="Guia Aviator Moçambique" class="quick-strip-thumb" width="68" height="52">
        <div class="quick-strip-meta">
          <strong>Aviator &amp; Crash Games: RNG e Chuva Grátis</strong>
          <span>Jogos Rápidos</span>
        </div>
      </a>
      <a href="/apostas-futebol/mocambola" class="quick-strip-card">
        <img src="{{ site.capa_padrao }}" alt="Apostas no Moçambola" class="quick-strip-thumb" width="68" height="52">
        <div class="quick-strip-meta">
          <strong>Guia do Moçambola: Mercados e Fator Casa</strong>
          <span>Futebol Nacional</span>
        </div>
      </a>
      <a href="/apps-de-apostas-mocambique" class="quick-strip-card">
        <img src="{{ site.capa_padrao }}" alt="Apps de Apostas MZ" class="quick-strip-thumb" width="68" height="52">
        <div class="quick-strip-meta">
          <strong>Apps Mobile: Betway App vs. Navegador Leve</strong>
          <span>Android, iOS &amp; Huawei</span>
        </div>
      </a>
    </div>
  </div>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="container">

    <!-- 5. HERO EDITORIAL COM IMAGEM DE CAPA + TOP 5 DINÂMICO -->
    <section class="hero-editorial-grid" aria-label="Destaque Principal">
      <div class="hero-main-card has-cover" style="background-image: url('{{ site.featured_home_imagem | default(site.capa_padrao) }}');">
        <span class="category-badge red">{{ site.featured_home_badge }}</span>
        <h1>{{ site.featured_home_titulo }}</h1>
        <p>{{ site.featured_home_resumo }}</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
          <a href="#tabela-comparativa" class="btn btn-cta">Ver Tabela Comparativa</a>
          <a href="{{ site.featured_home_url }}" class="btn btn-primary">Ranking Completo &rarr;</a>
        </div>
      </div>

      <aside class="top-panel-dark" aria-label="Top 5 Casas Licenciadas">
        <div class="top-panel-header">
          <h2>Top 5 Casas Licenciadas (IGJ)</h2>
          <a href="/melhores-casas-de-apostas-mocambique" class="section-more">Ver Todas</a>
        </div>
        <ul class="top-panel-list">
          {% for casa in casas.lista %}
          {% if casa.status == "ativo" %}
          <li class="top-panel-item">
            <div class="top-panel-brand">
              <img src="{{ casa.logo }}" alt="Logo {{ casa.nome }}" class="brand-logo-slot" width="68" height="34" loading="lazy">
              <div class="top-panel-info">
                <strong>{{ loop.index }}. {{ casa.nome }}</strong>
                <span>Dep. {{ casa.deposito_min }} | &#9733; {{ casa.nota_final }}/5</span>
              </div>
            </div>
            <a href="/ir/{{ casa.link_slug }}" target="_blank" rel="sponsored nofollow noopener" class="btn btn-cta btn-sm">Ver Oferta</a>
          </li>
          {% endif %}
          {% endfor %}
        </ul>
      </aside>
    </section>

    <!-- 6. TABELA DE COMPARAÇÃO DINÂMICA (ALIMENTADA PELO SVELTIA CMS) -->
    <section id="tabela-comparativa" aria-labelledby="titulo-tabela">
      <div class="section-header">
        <h2 class="section-title red-accent" id="titulo-tabela">Comparação Rápida: Casas de Apostas em Moçambique</h2>
        <a href="/como-avaliamos" class="section-more">Critérios de Avaliação &rarr;</a>
      </div>

      <div class="table-scroll-hint">
        <span>&larr; Deslize a tabela para o lado no telemóvel &rarr;</span>
      </div>

      <div class="table-wrapper">
        <table class="compare-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Casa de Apostas</th>
              <th>Oferta / Bónus Principal</th>
              <th>Depósito Mín.</th>
              <th>Pagamentos Locais</th>
              <th>Licença IGJ</th>
              <th>Nota</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            {% for casa in casas.lista %}
            {% if casa.status == "ativo" %}
            <tr class="{% if casa.destaque_home %}featured-row{% endif %}">
              <td><span class="rank-number">{{ loop.index }}</span></td>
              <td>
                <div class="table-brand-cell">
                  <img src="{{ casa.logo }}" alt="Logo {{ casa.nome }}" class="brand-logo-slot" width="68" height="34" loading="lazy">
                  <div>
                    <strong>{{ casa.nome }}</strong><br>
                    <a href="{{ casa.review_url }}" style="font-size:0.76rem;">Ler análise completa</a>
                  </div>
                </div>
              </td>
              <td>
                <strong>{{ casa.bonus_titulo }}</strong><br>
                <small style="color:var(--text-muted);">{{ casa.termos_resumo }}</small>
              </td>
              <td><strong>{{ casa.deposito_min }}</strong><br><small>Levant.: {{ casa.levantamento_min }}</small></td>
              <td>{{ casa.pagamentos }}</td>
              <td>{{ casa.operadora }}<br><small>{{ casa.licenca }}</small></td>
              <td><span class="rating-pill">&#9733; {{ casa.nota_final }}/5</span></td>
              <td>
                <a href="/ir/{{ casa.link_slug }}" target="_blank" rel="sponsored nofollow noopener" class="btn {% if casa.destaque_home %}btn-cta{% else %}btn-primary{% endif %} btn-sm">Criar Conta</a>
              </td>
            </tr>
            {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 7. FEATURED POSTS + TOP STORIES (ESTILO USA TODAY / SPORTNOW) -->
    <section aria-labelledby="titulo-destaques">
      <div class="section-header">
        <h2 class="section-title" id="titulo-destaques">Em Destaque &amp; Guias Essenciais</h2>
        <a href="/blog/" class="section-more">Ver Blog Completo &rarr;</a>
      </div>

      <div class="editorial-split-grid">
        <div class="visual-cards-grid">
          {% if collections.featured_posts and collections.featured_posts.length > 0 %}
            {% for post in collections.featured_posts %}
            {% if loop.index <= 4 %}
            <article class="visual-card">
              <div class="visual-card-media">
                <img src="{{ post.data.cover_image | default(site.capa_padrao) }}" alt="{{ post.data.cover_alt | default(post.data.h1) }}" loading="lazy">
                <span class="category-badge {{ post.data.badge_color | default('red') }}">{{ post.data.badge_text | default('Destaque') }}</span>
              </div>
              <div class="visual-card-body">
                <div>
                  <h3><a href="{{ post.url | replace('.html', '') }}">{{ post.data.h1 | default(post.data.title) }}</a></h3>
                  <p>{{ post.data.subtitle | default(post.data.description) }}</p>
                </div>
                <a href="{{ post.url | replace('.html', '') }}" class="btn btn-outline btn-sm">Ler Artigo &rarr;</a>
              </div>
            </article>
            {% endif %}
            {% endfor %}
          {% else %}
            <article class="visual-card">
              <div class="visual-card-media">
                <img src="{{ site.capa_padrao }}" alt="Bónus e Códigos Promocionais" loading="lazy">
                <span class="category-badge red">Bónus &amp; Regras</span>
              </div>
              <div class="visual-card-body">
                <div>
                  <h3><a href="/codigos-promocionais-e-bonus">Códigos Promocionais e Regras Reais de Rollover</a></h3>
                  <p>Entenda a diferença entre saldo real e bónus, prazos de validade e tetos de conversão em Meticais.</p>
                </div>
                <a href="/codigos-promocionais-e-bonus" class="btn btn-outline btn-sm">Ver Bónus &rarr;</a>
              </div>
            </article>
            <article class="visual-card">
              <div class="visual-card-media">
                <img src="{{ site.capa_padrao }}" alt="Pagamentos M-Pesa e-Mola M-Kesh" loading="lazy">
                <span class="category-badge green">Pagamentos Móveis</span>
              </div>
              <div class="visual-card-body">
                <div>
                  <h3><a href="/pagamentos/m-pesa">Como Depositar e Levantar com M-Pesa, e-Mola e M-Kesh</a></h3>
                  <p>Passo a passo para carregar desde 1 MT e aprovar transações M-Kesh no menu *500#.</p>
                </div>
                <a href="/pagamentos/m-pesa" class="btn btn-outline btn-sm">Ver Pagamentos &rarr;</a>
              </div>
            </article>
          {% endif %}
        </div>

        <aside class="top-stories-box" aria-label="Guias Mais Lidos">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:2px solid var(--border-color);">
            <h3 style="font-size:1.05rem; font-weight:800;">Guias Mais Lidos</h3>
            <a href="/guias/como-apostar-iniciantes" style="font-size:0.78rem; font-weight:700;">Ver Todos</a>
          </div>
          <ol class="top-stories-list">
            <li class="top-story-item">
              <span class="top-story-num">1</span>
              <div class="top-story-info">
                <a href="/guias/como-apostar-iniciantes">Como Começar a Apostar Online em Moçambique</a>
                <span>Iniciantes &bull; Desde 1 MT</span>
              </div>
              <img src="{{ site.capa_padrao }}" alt="Guia Iniciantes" class="top-story-thumb" width="58" height="48" loading="lazy">
            </li>
            <li class="top-story-item">
              <span class="top-story-num">2</span>
              <div class="top-story-info">
                <a href="/guias/aviator-e-jogos-crash">Aviator e Jogos Crash: RNG, Auto Cash Out e Riscos</a>
                <span>Jogos Rápidos</span>
              </div>
              <img src="{{ site.capa_padrao }}" alt="Aviator" class="top-story-thumb" width="58" height="48" loading="lazy">
            </li>
            <li class="top-story-item">
              <span class="top-story-num">3</span>
              <div class="top-story-info">
                <a href="/guias/tipos-de-apostas">Handicap Asiático vs. Europeu, Golos e Cartões</a>
                <span>Mercados Desportivos</span>
              </div>
              <img src="{{ site.capa_padrao }}" alt="Handicap" class="top-story-thumb" width="58" height="48" loading="lazy">
            </li>
            <li class="top-story-item">
              <span class="top-story-num">4</span>
              <div class="top-story-info">
                <a href="/guias/o-que-sao-odds">O Que São Odds e Como Calcular o Seu Lucro em MT</a>
                <span>Cotações &amp; Matemática</span>
              </div>
              <img src="{{ site.capa_padrao }}" alt="Odds" class="top-story-thumb" width="58" height="48" loading="lazy">
            </li>
            <li class="top-story-item">
              <span class="top-story-num">5</span>
              <div class="top-story-info">
                <a href="/guias/gestao-de-banca">Gestão de Banca: Como Proteger o Seu Saldo</a>
                <span>Controlo &amp; Jogo Responsável</span>
              </div>
              <img src="{{ site.capa_padrao }}" alt="Banca" class="top-story-thumb" width="58" height="48" loading="lazy">
            </li>
          </ol>
        </aside>
      </div>
    </section>

  </main>

  <!-- RODAPÉ INSTITUCIONAL -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>Sobre o {{ site.nome }}</h4>
          <p style="color:#94a3b8; margin-bottom:0.85rem;">
            O MocaPlay.site é um portal informativo e comparador independente de casas de apostas desportivas em Moçambique. Não operamos jogos de fortuna ou azar nem aceitamos apostas diretamente.
          </p>
          <span class="badge-18">+18 APENAS MAIORES DE IDADE</span>
        </div>

        <div class="footer-col">
          <h4>Casas Analisadas</h4>
          <ul class="footer-links">
            {% for casa in casas.lista %}
            <li><a href="{{ casa.review_url }}">{{ casa.nome }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-col">
          <h4>Guias &amp; Pagamentos</h4>
          <ul class="footer-links">
            <li><a href="/melhores-casas-de-apostas-mocambique">Ranking Melhores Casas</a></li>
            <li><a href="/codigos-promocionais-e-bonus">Bónus e Códigos Promocionais</a></li>
            <li><a href="/pagamentos/m-pesa">Depósitos com M-Pesa</a></li>
            <li><a href="/pagamentos/e-mola">Depósitos com e-Mola</a></li>
            <li><a href="/pagamentos/mkesh">Depósitos com M-Kesh</a></li>
            <li><a href="/guias/aviator-e-jogos-crash">Guia Aviator e Crash</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Transparência &amp; Legal</h4>
          <ul class="footer-links">
            <li><a href="/como-avaliamos">Como Avaliamos</a></li>
            <li><a href="/sobre">Sobre Nós</a></li>
            <li><a href="/equipa-e-autores">Equipa e Autores</a></li>
            <li><a href="/jogo-responsavel">Jogo Responsável (+18)</a></li>
            <li><a href="/aviso-de-afiliados">Aviso de Afiliados</a></li>
            <li><a href="/politica-de-privacidade">Política de Privacidade</a></li>
            <li><a href="/termos-de-uso">Termos de Uso</a></li>
            <li><a href="/contacto">Contacto</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-legal-notice">
        {{ site.aviso_rodape }} Consulte a nossa página de <a href="/jogo-responsavel" style="color:#fff; text-decoration:underline;">Jogo Responsável</a> e a nossa <a href="/como-avaliamos" style="color:#fff; text-decoration:underline;">Metodologia de Avaliação</a>.
      </div>

      <div class="footer-bottom">
        <span>&copy; 2026 {{ site.nome }} (mocaplay.site). Todos os direitos reservados.</span>
        <span>Desenvolvido para apostadores em Moçambique (pt-MZ).</span>
      </div>
    </div>
  </footer>

  <script src="/script.js" defer></script>
</body>
</html>
