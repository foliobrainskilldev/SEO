<!DOCTYPE html>
<html lang="pt-MZ">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <link rel="canonical" href="{{ site.dominio }}{{ page.url | replace('.html', '') }}">

  <!-- Open Graph / Redes Sociais -->
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.dominio }}{{ page.url | replace('.html', '') }}">
  <meta property="og:site_name" content="{{ site.nome }}">
  <meta property="og:locale" content="pt_MZ">
  <meta property="og:image" content="{{ site.dominio }}{{ cover_image | default(site.capa_padrao) }}">

  <!-- Favicon Oficial -->
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48">
  <link rel="icon" type="image/png" href="/favicon-32x32.png?v=2" sizes="32x32">
  <link rel="icon" type="image/png" href="/android-chrome-192x192.png?v=2" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="stylesheet" href="/style.css">
  <style>
    .cms-body-wrap { width: 100%; max-width: 100%; overflow-wrap: break-word; }
    .cms-body-wrap .btn, .hero-main-card .btn { white-space: normal; max-width: 100%; line-height: 1.35; }
  </style>

  <!-- Dados Estruturados JSON-LD Automáticos -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.dominio }}/#organization",
        "name": "{{ site.nome }}",
        "url": "{{ site.dominio }}/",
        "logo": "{{ site.dominio }}{{ site.logo_header }}"
      },
      {
        "@type": "BreadcrumbList",
        "@id": "{{ site.dominio }}{{ page.url | replace('.html', '') }}#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Início", "item": "{{ site.dominio }}/" },
          { "@type": "ListItem", "position": 2, "name": "{{ seccao_nome | default('Artigos & Guias') }}", "item": "{{ site.dominio }}/blog/" },
          { "@type": "ListItem", "position": 3, "name": "{{ breadcrumb | default(h1) }}", "item": "{{ site.dominio }}{{ page.url | replace('.html', '') }}" }
        ]
      }
      {% if faqs and faqs.length > 0 %},
      {
        "@type": "FAQPage",
        "@id": "{{ site.dominio }}{{ page.url | replace('.html', '') }}#faq",
        "mainEntity": [
          {% for item in faqs %}
          {
            "@type": "Question",
            "name": "{{ item.pergunta | replace('"', '\\"') }}",
            "acceptedAnswer": { "@type": "Answer", "text": "{{ item.resposta | replace('"', '\\"') }}" }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }
      {% endif %}
    ]
  }
  </script>
</head>
<body>

  <!-- 1. TOPBAR -->
  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-left">
        <span class="live-dot" aria-hidden="true"></span>
        <span id="current-date">Qua, 25 Nov 2026</span>
        <span class="topbar-trending">
          <strong>Em Destaque:</strong> {{ topbar_text | default(site.topbar_destaque) }}
        </span>
      </div>
      <div class="topbar-right">
        <span class="badge-18">+18</span>
        <span>Jogue com moderação</span>
      </div>
    </div>
  </div>

  <!-- 2. HEADER BRANCO ESTILO USA TODAY -->
  <header class="site-header">
    <div class="container header-grid">
      <a href="/" class="brand-logo" aria-label="{{ site.nome }} - Página Inicial">
        <img src="{{ site.logo_header }}" alt="{{ site.nome }}" class="brand-logo-full" width="180" height="44">
      </a>

      <div class="header-banner">
        <div class="header-banner-text">
          <strong>Destaque #1 MZ:</strong> Placard.co.mz com depósitos desde 1 MT e Boost até 1000%.
        </div>
        <a href="{{ site.cta_header_url }}" target="_blank" rel="sponsored nofollow noopener" class="btn btn-cta btn-sm">
          Visitar Placard &rarr;
        </a>
      </div>
    </div>
  </header>

  <!-- 3. MENU DE NAVEGAÇÃO -->
  <nav class="navbar" aria-label="Navegação Principal">
    <div class="container navbar-inner">
      <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="nav-links">
        &#9776; Menu
      </button>

      <ul class="nav-links" id="nav-links">
        <li><a href="/">Início</a></li>
        <li><a href="/melhores-casas-de-apostas-mocambique">Melhores Casas</a></li>
        <li><a href="/codigos-promocionais-e-bonus">Bónus &amp; Códigos</a></li>
        <li><a href="/pagamentos/m-pesa">M-Pesa &amp; Pagamentos</a></li>
        <li><a href="/apps-de-apostas-mocambique">Apps Mobile</a></li>
        <li><a href="/guias/como-apostar-iniciantes">Guias</a></li>
        <li><a href="/apostas-futebol/">Futebol &amp; Moçambola</a></li>
      </ul>

      <a href="{{ site.cta_header_url }}" target="_blank" rel="sponsored nofollow noopener" class="nav-cta-btn">
        &#9654; {{ site.cta_header_texto }}
      </a>
    </div>
  </nav>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="container">

    <ol class="breadcrumbs" aria-label="caminho de navegação">
      <li><a href="/">Início</a></li>
      <li><a href="/blog/">{{ seccao_nome | default('Artigos & Guias') }}</a></li>
      <li aria-current="page">{{ breadcrumb | default(h1) }}</li>
    </ol>

    <div class="article-meta-bar">
      <span class="author-badge">
        Escrito por {{ site.autor_nome }}
        <svg class="verified-icon" viewBox="0 0 24 24" aria-label="Autor Verificado" role="img">
          <path d="M12 2L14.8 4.5L18.5 4.1L19.8 7.6L23 9.5L21.8 13L23 16.5L19.8 18.4L18.5 21.9L14.8 21.5L12 24L9.2 21.5L5.5 21.9L4.2 18.4L1 16.5L2.2 13L1 9.5L4.2 7.6L5.5 4.1L9.2 4.5L12 2ZM10.4 16.6L17.2 9.8L15.8 8.4L10.4 13.8L8.2 11.6L6.8 13L10.4 16.6Z"/>
        </svg>
      </span>
      <span>Atualizado em: <span class="dynamic-date">25 de Novembro de 2026</span></span>
      <span>Verificado: <a href="/como-avaliamos">Metodologia MocaPlay</a></span>
    </div>

    <!-- HERO COM IMAGEM DE CAPA + TOP 5 DINÂMICO -->
    <section class="hero-editorial-grid" aria-label="Cabeçalho do Artigo">
      <div class="hero-main-card has-cover" style="background-image: url('{{ cover_image | default(site.capa_padrao) }}');">
        <span class="category-badge {{ badge_color | default('red') }}">{{ badge_text | default('Guia Oficial Moçambique') }}</span>
        <h1>{{ h1 }}</h1>
        <p>{{ subtitle }}</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
          <a href="{{ cta_url | default('/ir/placard') }}" target="_blank" rel="sponsored nofollow noopener" class="btn btn-cta">
            {{ cta_text | default('Visitar Placard.co.mz') }} &rarr;
          </a>
          <a href="/melhores-casas-de-apostas-mocambique" class="btn btn-primary">Ver Ranking IGJ</a>
        </div>
      </div>

      <aside class="top-panel-dark" aria-label="Top Casas Licenciadas">
        <div class="top-panel-header">
          <h2>Top Casas Licenciadas MZ</h2>
          <a href="/melhores-casas-de-apostas-mocambique" class="section-more">Ver Todas</a>
        </div>
        <ul class="top-panel-list">
          {% for casa in casas.lista %}
          {% if casa.status == "ativo" %}
          <li class="top-panel-item">
            <div class="top-panel-brand">
              <img src="{{ casa.logo }}" alt="Logo {{ casa.nome }}" class="brand-logo-slot" width="68" height="34" loading="lazy">
              <div class="top-panel-info">
                <strong>{{ loop.index }}. {{ casa.nome }}</strong>
                <span>{{ casa.deposito_min }} | &#9733; {{ casa.nota_final }}/5</span>
              </div>
            </div>
            <a href="/ir/{{ casa.link_slug }}" target="_blank" rel="sponsored nofollow noopener" class="btn btn-cta btn-sm">Visitar</a>
          </li>
          {% endif %}
          {% endfor %}
        </ul>
      </aside>
    </section>

    <!-- CORPO DO ARTIGO -->
    <article class="content-prose cms-body-wrap">
      {{ content | safe }}
    </article>

    <!-- FAQ AUTOMÁTICO -->
    {% if faqs and faqs.length > 0 %}
    <section aria-labelledby="titulo-faq-artigo">
      <div class="section-header">
        <h2 class="section-title red-accent" id="titulo-faq-artigo">Perguntas Frequentes (FAQ)</h2>
      </div>
      <div class="faq-list">
        {% for item in faqs %}
        <div class="faq-item {% if loop.first %}active{% endif %}">
          <button class="faq-question" aria-expanded="{% if loop.first %}true{% else %}false{% endif %}">
            <span>{{ item.pergunta }}</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer"><p>{{ item.resposta }}</p></div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- CONTEÚDOS RELACIONADOS & FEATURED POSTS (BACKLINKS INTERNOS AUTOMÁTICOS) -->
    {% if collections.featured_posts and collections.featured_posts.length > 0 %}
    <section aria-labelledby="titulo-relacionados">
      <div class="section-header">
        <h2 class="section-title" id="titulo-relacionados">Destaques &amp; Conteúdos Relacionados</h2>
        <a href="/blog/" class="section-more">Ver Todos &rarr;</a>
      </div>
      <div class="visual-cards-grid">
        {% for post in collections.featured_posts %}
        {% if post.url != page.url and loop.index <= 4 %}
        <article class="visual-card">
          <div class="visual-card-media">
            <img src="{{ post.data.cover_image | default(site.capa_padrao) }}" alt="{{ post.data.cover_alt | default(post.data.h1) }}" loading="lazy">
            <span class="category-badge {{ post.data.badge_color | default('red') }}">{{ post.data.badge_text | default('Destaque') }}</span>
          </div>
          <div class="visual-card-body">
            <div>
              <h3><a href="{{ post.url | replace('.html', '') }}">{{ post.data.h1 | default(post.data.title) }}</a></h3>
              <p>{{ post.data.subtitle | default(post.data.description) }}</p>
            </div>
            <a href="{{ post.url | replace('.html', '') }}" class="btn btn-outline btn-sm">Ler Artigo &rarr;</a>
          </div>
        </article>
        {% endif %}
        {% endfor %}
      </div>
    </section>
    {% endif %}

  </main>

  <!-- RODAPÉ INSTITUCIONAL -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>Sobre o {{ site.nome }}</h4>
          <p style="color:#94a3b8; margin-bottom:0.85rem;">
            O MocaPlay.site é um portal informativo e comparador independente de casas de apostas desportivas em Moçambique. Não operamos jogos de fortuna ou azar nem aceitamos apostas diretamente.
          </p>
          <span class="badge-18">+18 APENAS MAIORES DE IDADE</span>
        </div>

        <div class="footer-col">
          <h4>Casas Analisadas</h4>
          <ul class="footer-links">
            {% for casa in casas.lista %}
            <li><a href="{{ casa.review_url }}">{{ casa.nome }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-col">
          <h4>Guias &amp; Pagamentos</h4>
          <ul class="footer-links">
            <li><a href="/melhores-casas-de-apostas-mocambique">Ranking Melhores Casas</a></li>
            <li><a href="/codigos-promocionais-e-bonus">Bónus e Códigos Promocionais</a></li>
            <li><a href="/pagamentos/m-pesa">Depósitos com M-Pesa</a></li>
            <li><a href="/pagamentos/e-mola">Depósitos com e-Mola</a></li>
            <li><a href="/pagamentos/mkesh">Depósitos com M-Kesh</a></li>
            <li><a href="/guias/aviator-e-jogos-crash">Guia Aviator e Crash</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Transparência &amp; Legal</h4>
          <ul class="footer-links">
            <li><a href="/como-avaliamos">Como Avaliamos</a></li>
            <li><a href="/sobre">Sobre Nós</a></li>
            <li><a href="/equipa-e-autores">Equipa e Autores</a></li>
            <li><a href="/jogo-responsavel">Jogo Responsável (+18)</a></li>
            <li><a href="/aviso-de-afiliados">Aviso de Afiliados</a></li>
            <li><a href="/politica-de-privacidade">Política de Privacidade</a></li>
            <li><a href="/termos-de-uso">Termos de Uso</a></li>
            <li><a href="/contacto">Contacto</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-legal-notice">
        {{ site.aviso_rodape }} Consulte a nossa página de <a href="/jogo-responsavel" style="color:#fff; text-decoration:underline;">Jogo Responsável</a> e a nossa <a href="/como-avaliamos" style="color:#fff; text-decoration:underline;">Metodologia de Avaliação</a>.
      </div>

      <div class="footer-bottom">
        <span>&copy; 2026 {{ site.nome }} (mocaplay.site). Todos os direitos reservados.</span>
        <span>Desenvolvido para apostadores em Moçambique (pt-MZ).</span>
      </div>
    </div>
  </footer>

  <script src="/script.js" defer></script>
</body>
</html>
